# Kopiere diese Datei nach firmware/secrets.yaml und trage deine Werte ein.
# secrets.yaml ist per .gitignore vom Repo ausgeschlossen.

wifi_ssid: "MEIN_WLAN"
wifi_password: "WLAN_PASSWORT"

# Passwort für den Fallback-Setup-Accesspoint des Geräts.
ap_password: "setup-passwort"

# Passwort für drahtlose Updates (OTA).
ota_password: "ota-passwort"

# MQTT-Broker im eigenen Netz (z. B. Mosquitto). Gleiche Adresse wie in SantaTAB.
mqtt_broker: "10.1.1.50"
mqtt_user: "diffuser"
mqtt_password: "mqtt-passwort"
